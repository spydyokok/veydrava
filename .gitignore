# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.agents/
/.codex/
/outputs/
/work/

# Veydrava local secrets, chain build products and durable service state
!.env.example
/contracts/out/
/contracts/cache/
/contracts/build/
/broadcast/
/data/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.tsbuildinfo
# No recursively embedded archives in source downloads
/source-archives/
